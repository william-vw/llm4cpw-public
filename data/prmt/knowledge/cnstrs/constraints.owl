@prefix : <http://notation3.org/constraints.owl#> .
@prefix ns1: <http://notation3.org/ltl_constraints.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://notation3.org/constraints.owl#> .

<http://notation3.org/constraints.owl#> rdf:type owl:Ontology .

#################################################################
#    Annotation properties
#################################################################

###  http://notation3.org/constraints.owl#hasLolaSyntax
:hasLolaSyntax rdf:type owl:AnnotationProperty ;
               rdfs:range xsd:string ;
               rdfs:domain ns1:LtlOperator .


###  http://www.w3.org/2000/01/rdf-schema#comment
rdfs:comment rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2000/01/rdf-schema#domain
rdfs:domain rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2000/01/rdf-schema#range
rdfs:range rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2000/01/rdf-schema#subClassOf
rdfs:subClassOf rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2000/01/rdf-schema#type
rdfs:type rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://notation3.org/constraints.owl#hasAggregate
:hasAggregate rdf:type owl:ObjectProperty ;
              rdfs:domain :PartOf ;
              rdfs:range :Task .


###  http://notation3.org/constraints.owl#hasCondition
:hasCondition rdf:type owl:ObjectProperty ;
              rdfs:domain :PrioritizedConditional ;
              rdfs:range :Condition .


###  http://notation3.org/constraints.owl#hasConditionMarker
:hasConditionMarker rdf:type owl:ObjectProperty ;
                    rdfs:domain :PrioritizedConditional ;
                    rdfs:range :Task .


###  http://notation3.org/constraints.owl#hasConditionalTask
:hasConditionalTask rdf:type owl:ObjectProperty ;
                    rdfs:domain :PrioritizedConditional ;
                    rdfs:range :Task .


###  http://notation3.org/constraints.owl#hasConstraint
:hasConstraint rdf:type owl:ObjectProperty ;
               rdfs:domain :ProcessModel ;
               rdfs:range :Constraint .


###  http://notation3.org/constraints.owl#hasDecisionTask
:hasDecisionTask rdf:type owl:ObjectProperty ;
                 rdfs:domain [ rdf:type owl:Class ;
                               owl:unionOf ( :DecisionalDependency
                                             :PrioritizedConditional
                                           )
                             ] ;
                 rdfs:range :Task .


###  http://notation3.org/constraints.owl#hasDependentTask
:hasDependentTask rdf:type owl:ObjectProperty ;
                  rdfs:domain :DecisionalDependency ;
                  rdfs:range :Task .


###  http://notation3.org/constraints.owl#hasInterferedTask
:hasInterferedTask rdf:type owl:ObjectProperty ;
                   rdfs:domain :Conflict ;
                   rdfs:range :Task .


###  http://notation3.org/constraints.owl#hasInterferingTask
:hasInterferingTask rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf owl:topObjectProperty ;
                    rdfs:domain :Conflict ;
                    rdfs:range :Task .


###  http://notation3.org/constraints.owl#hasLtlFormula
:hasLtlFormula rdf:type owl:ObjectProperty ;
               rdfs:domain :Constraint ;
               rdfs:range ns1:LtlFormula .


###  http://notation3.org/constraints.owl#hasPart
:hasPart rdf:type owl:ObjectProperty ;
         rdfs:domain :PartOf ;
         rdfs:range :Task .


###  http://notation3.org/constraints.owl#hasReplaced
:hasReplaced rdf:type owl:ObjectProperty ;
             rdfs:domain :Alternative ;
             rdfs:range :Task .


###  http://notation3.org/constraints.owl#hasReplacement
:hasReplacement rdf:type owl:ObjectProperty ;
                rdfs:domain :Alternative ;
                rdfs:range :Task .


###  http://notation3.org/constraints.owl#hasTask
:hasTask rdf:type owl:ObjectProperty ;
         owl:inverseOf :taskOf ;
         rdfs:domain [ rdf:type owl:Class ;
                       owl:unionOf ( :Constraint
                                     :ProcessModel
                                   )
                     ] ;
         rdfs:range :Task .


###  http://notation3.org/constraints.owl#taskOf
:taskOf rdf:type owl:ObjectProperty .


###  http://notation3.org/ltl_constraints.owl#hasLeftOperand
ns1:hasLeftOperand rdf:type owl:ObjectProperty ;
                   rdfs:domain ns1:BinaryOperator ;
                   rdfs:range ns1:LtlFormula ;
                   rdfs:comment "The left-hand LTL formula (operand) that the binary operator applies to." .


###  http://notation3.org/ltl_constraints.owl#hasOperand
ns1:hasOperand rdf:type owl:ObjectProperty ;
               rdfs:domain ns1:UnaryOperator ;
               rdfs:range ns1:LtlFormula ;
               rdfs:comment "The LTL formula (operand) that the unary operator applies to." .


###  http://notation3.org/ltl_constraints.owl#hasRightOperand
ns1:hasRightOperand rdf:type owl:ObjectProperty ;
                    rdfs:domain ns1:BinaryOperator ;
                    rdfs:range ns1:LtlFormula ;
                    rdfs:comment "The right-hand LTL formula (operand) that the binary operator applies to." .


#################################################################
#    Data properties
#################################################################

###  http://notation3.org/constraints.owl#isDecisionOptional
:isDecisionOptional rdf:type owl:DatatypeProperty ;
                    rdfs:domain :DecisionalDependency ;
                    rdfs:range xsd:boolean .


###  http://notation3.org/constraints.owl#isDependentOptional
:isDependentOptional rdf:type owl:DatatypeProperty ;
                     rdfs:domain :DecisionalDependency ;
                     rdfs:range xsd:boolean .


#################################################################
#    Classes
#################################################################

###  http://notation3.org/constraints.owl#Alternative
:Alternative rdf:type owl:Class ;
             rdfs:subClassOf :Constraint .


###  http://notation3.org/constraints.owl#Condition
:Condition rdf:type owl:Class ;
           rdfs:subClassOf :ProcessElement .


###  http://notation3.org/constraints.owl#Conflict
:Conflict rdf:type owl:Class ;
          rdfs:subClassOf :Constraint .


###  http://notation3.org/constraints.owl#Constraint
:Constraint rdf:type owl:Class .


###  http://notation3.org/constraints.owl#DecisionalDependency
:DecisionalDependency rdf:type owl:Class ;
                      rdfs:subClassOf :Constraint .


###  http://notation3.org/constraints.owl#EntryPoint
:EntryPoint rdf:type owl:Class ;
       rdfs:subClassOf :Constraint .


###  http://notation3.org/constraints.owl#ExitPoint
:ExitPoint rdf:type owl:Class ;
      rdfs:subClassOf :Constraint .


###  http://notation3.org/constraints.owl#LtlConstraint
:LtlConstraint rdf:type owl:Class ;
               rdfs:subClassOf :Constraint .


###  http://notation3.org/constraints.owl#PartOf
:PartOf rdf:type owl:Class ;
        rdfs:subClassOf :Constraint .


###  http://notation3.org/constraints.owl#PrioritizedConditional
:PrioritizedConditional rdf:type owl:Class ;
                        rdfs:subClassOf :Constraint .


###  http://notation3.org/constraints.owl#ProcessElement
:ProcessElement rdf:type owl:Class .


###  http://notation3.org/constraints.owl#ProcessModel
:ProcessModel rdf:type owl:Class .


###  http://notation3.org/constraints.owl#Task
:Task rdf:type owl:Class ;
      rdfs:subClassOf :ProcessElement .


###  http://notation3.org/ltl_constraints.owl#And
ns1:And rdf:type owl:Class ;
        rdfs:subClassOf ns1:BinaryOperator ;
        :hasLolaSyntax "AND" ;
        rdfs:type rdfs:Class .


###  http://notation3.org/ltl_constraints.owl#BinaryOperator
ns1:BinaryOperator rdf:type owl:Class ;
                   rdfs:subClassOf ns1:LtlOperator ;
                   rdfs:comment "A binary LTL operator." ;
                   rdfs:type rdfs:Class .


###  http://notation3.org/ltl_constraints.owl#Eventually
ns1:Eventually rdf:type owl:Class ;
               rdfs:subClassOf ns1:UnaryOperator ;
               :hasLolaSyntax "F" ;
               rdfs:type rdfs:Class .


###  http://notation3.org/ltl_constraints.owl#Globally
ns1:Globally rdf:type owl:Class ;
             rdfs:subClassOf ns1:UnaryOperator ;
             :hasLolaSyntax "G" ;
             rdfs:type rdfs:Class .


###  http://notation3.org/ltl_constraints.owl#Implies
ns1:Implies rdf:type owl:Class ;
            rdfs:subClassOf ns1:BinaryOperator ;
            :hasLolaSyntax "->" ;
            rdfs:type rdfs:Class .


###  http://notation3.org/ltl_constraints.owl#LtlAtom
ns1:LtlAtom rdf:type owl:Class ;
            rdfs:subClassOf ns1:LtlFormula ;
            rdfs:comment "An atomic LTL fact." ;
            rdfs:type rdfs:Class .


###  http://notation3.org/ltl_constraints.owl#LtlFormula
ns1:LtlFormula rdf:type owl:Class ;
               rdfs:comment "An LTL formula." ;
               rdfs:type rdfs:Class .


###  http://notation3.org/ltl_constraints.owl#LtlOperator
ns1:LtlOperator rdf:type owl:Class ;
                rdfs:subClassOf ns1:LtlFormula ;
                rdfs:comment "An LTL operator for LTL formulas." ;
                rdfs:type rdfs:Class .


###  http://notation3.org/ltl_constraints.owl#Negation
ns1:Negation rdf:type owl:Class ;
             rdfs:subClassOf ns1:UnaryOperator ;
             :hasLolaSyntax "NOT" ;
             rdfs:type rdfs:Class .


###  http://notation3.org/ltl_constraints.owl#Next
ns1:Next rdf:type owl:Class ;
         rdfs:subClassOf ns1:UnaryOperator ;
         :hasLolaSyntax "X" ;
         rdfs:type rdfs:Class .


###  http://notation3.org/ltl_constraints.owl#Or
ns1:Or rdf:type owl:Class ;
       rdfs:subClassOf ns1:BinaryOperator ;
       :hasLolaSyntax "OR" .


###  http://notation3.org/ltl_constraints.owl#Release
ns1:Release rdf:type owl:Class ;
            rdfs:subClassOf ns1:BinaryOperator ;
            :hasLolaSyntax "R" .


###  http://notation3.org/ltl_constraints.owl#UnaryOperator
ns1:UnaryOperator rdf:type owl:Class ;
                  rdfs:subClassOf ns1:LtlOperator ;
                  rdfs:comment "A unary LTL operator." ;
                  rdfs:type rdfs:Class .


###  http://notation3.org/ltl_constraints.owl#Until
ns1:Until rdf:type owl:Class ;
          rdfs:subClassOf ns1:BinaryOperator ;
          :hasLolaSyntax "U" ;
          rdfs:type rdfs:Class .


###  http://notation3.org/ltl_constraints.owl#WeakUntil
ns1:WeakUntil rdf:type owl:Class ;
              rdfs:subClassOf ns1:BinaryOperator ;
              :hasLolaSyntax "W" .


#################################################################
#    Individuals
#################################################################

###  http://notation3.org/constraints.owl#Admit_to_hospital
:Admit_to_hospital rdf:type owl:NamedIndividual ,
                            :Task ;
                   rdfs:label "Admit to hospital" .


###  http://notation3.org/constraints.owl#Assess_airway
:Assess_airway rdf:type owl:NamedIndividual ,
                        :Task ;
               rdfs:label "Assess airway" .


###  http://notation3.org/constraints.owl#Assess_breathing
:Assess_breathing rdf:type owl:NamedIndividual ,
                           :Task ;
                  rdfs:label "Assess breathing" .


###  http://notation3.org/constraints.owl#Assess_circulation
:Assess_circulation rdf:type owl:NamedIndividual ,
                             :Task ;
                    rdfs:label "Assess circulation" .


###  http://notation3.org/constraints.owl#Assess_high-risk_markers
:Assess_high-risk_markers rdf:type owl:NamedIndividual ,
                                   :Task ;
                          rdfs:label "Assess high-risk markers" .


###  http://notation3.org/constraints.owl#Assess_level_of_care_required
:Assess_level_of_care_required rdf:type owl:NamedIndividual ,
                                        :Task ;
                               rdfs:label "Assess level of care required" .


###  http://notation3.org/constraints.owl#Blood_cultures
:Blood_cultures rdf:type owl:NamedIndividual ,
                         :Task ;
                rdfs:label "Blood cultures" .


###  http://notation3.org/constraints.owl#Blood_urea_nitrogen
:Blood_urea_nitrogen rdf:type owl:NamedIndividual ,
                              :Task ;
                     rdfs:label "Blood urea nitrogen" .


###  http://notation3.org/constraints.owl#CAP
:CAP rdf:type owl:NamedIndividual ,
              :ProcessModel ;
     :hasConstraint :CAP_1 ,
                    :CAP_2 ,
                    :CAP_3 ,
                    :CAP_4 ,
                    :CAP_6 ,
                    :cap5 ;
     rdfs:label "CAP" .


###  http://notation3.org/constraints.owl#CAP_1
:CAP_1 rdf:type owl:NamedIndividual ,
                :DecisionalDependency ;
       :hasDecisionTask :Perform_chest_x-ray ;
       :hasDependentTask :Give_antibiotics ;
       :hasLtlFormula :CAP_1_L1 ;
       :isDecisionOptional "true"^^xsd:boolean ;
       :isDependentOptional "true"^^xsd:boolean ;
       rdfs:label "cap1" .


###  http://notation3.org/constraints.owl#CAP_1_L1
:CAP_1_L1 rdf:type owl:NamedIndividual ,
                   ns1:Until ;
          ns1:hasLeftOperand :CAP_1_L1_1 ;
          ns1:hasRightOperand :Perform_chest_x-ray .


###  http://notation3.org/constraints.owl#CAP_1_L1_1
:CAP_1_L1_1 rdf:type owl:NamedIndividual ,
                     ns1:Negation ;
            ns1:hasOperand :Give_antibiotics .


###  http://notation3.org/constraints.owl#CAP_2
:CAP_2 rdf:type owl:NamedIndividual ,
                :DecisionalDependency ;
       :hasDecisionTask :PCR_testing_for_Legionella ;
       :hasDependentTask :Give_antibiotics ;
       :hasLtlFormula :CAP_2_L1 ;
       :isDecisionOptional "true"^^xsd:boolean ;
       :isDependentOptional "true"^^xsd:boolean ;
       rdfs:label "cap2" .


###  http://notation3.org/constraints.owl#CAP_2_L1
:CAP_2_L1 rdf:type owl:NamedIndividual ,
                   ns1:Globally ;
          ns1:hasOperand :CAP_2_L1_1 .


###  http://notation3.org/constraints.owl#CAP_2_L1_1
:CAP_2_L1_1 rdf:type owl:NamedIndividual ,
                     ns1:Implies ;
            ns1:hasLeftOperand :CAP_2_L1_1_1 ;
            ns1:hasRightOperand :CAP_2_L1_1_2 .


###  http://notation3.org/constraints.owl#CAP_2_L1_1_1
:CAP_2_L1_1_1 rdf:type owl:NamedIndividual ,
                       ns1:Eventually ;
              ns1:hasOperand :PCR_testing_for_Legionella .


###  http://notation3.org/constraints.owl#CAP_2_L1_1_2
:CAP_2_L1_1_2 rdf:type owl:NamedIndividual ,
                       ns1:Until ;
              ns1:hasLeftOperand :CAP_2_L1_1_2_1 ;
              ns1:hasRightOperand :PCR_testing_for_Legionella .


###  http://notation3.org/constraints.owl#CAP_2_L1_1_2_1
:CAP_2_L1_1_2_1 rdf:type owl:NamedIndividual ,
                         ns1:Negation ;
                ns1:hasOperand :Give_antibiotics .


###  http://notation3.org/constraints.owl#CAP_3
:CAP_3 rdf:type owl:NamedIndividual ,
                :DecisionalDependency ;
       :hasDecisionTask :Blood_cultures ;
       :hasDependentTask :Give_antibiotics ;
       :hasLtlFormula :CAP_3_L1 ;
       :isDecisionOptional "true"^^xsd:boolean ;
       :isDependentOptional "true"^^xsd:boolean ;
       rdfs:label "cap3" .


###  http://notation3.org/constraints.owl#CAP_3_L1
:CAP_3_L1 rdf:type owl:NamedIndividual ,
                   ns1:Globally ;
          ns1:hasOperand :CAP_3_L1_1 .


###  http://notation3.org/constraints.owl#CAP_3_L1_1
:CAP_3_L1_1 rdf:type owl:NamedIndividual ,
                     ns1:Implies ;
            ns1:hasLeftOperand :CAP_3_L1_1_1 ;
            ns1:hasRightOperand :CAP_3_L1_1_2 .


###  http://notation3.org/constraints.owl#CAP_3_L1_1_1
:CAP_3_L1_1_1 rdf:type owl:NamedIndividual ,
                       ns1:Eventually ;
              ns1:hasOperand :Blood_cultures .


###  http://notation3.org/constraints.owl#CAP_3_L1_1_2
:CAP_3_L1_1_2 rdf:type owl:NamedIndividual ,
                       ns1:Until ;
              ns1:hasLeftOperand :CAP_3_L1_1_2_1 ;
              ns1:hasRightOperand :Blood_cultures .


###  http://notation3.org/constraints.owl#CAP_3_L1_1_2_1
:CAP_3_L1_1_2_1 rdf:type owl:NamedIndividual ,
                         ns1:Negation ;
                ns1:hasOperand :Give_antibiotics .


###  http://notation3.org/constraints.owl#CAP_4
:CAP_4 rdf:type owl:NamedIndividual ,
                :Conflict ;
       :hasInterferedTask :Blood_cultures ;
       :hasInterferingTask :Give_antibiotics ;
       :hasLtlFormula :CAP_4_L1 ;
       rdfs:label "cap4" .


###  http://notation3.org/constraints.owl#CAP_4_L1
:CAP_4_L1 rdf:type owl:NamedIndividual ,
                   ns1:Globally ;
          ns1:hasOperand :CAP_4_L1_1 .


###  http://notation3.org/constraints.owl#CAP_4_L1_1
:CAP_4_L1_1 rdf:type owl:NamedIndividual ,
                     ns1:Implies ;
            ns1:hasLeftOperand :CAP_4_L1_1_1 ;
            ns1:hasRightOperand :CAP_4_L1_1_2 .


###  http://notation3.org/constraints.owl#CAP_4_L1_1_1
:CAP_4_L1_1_1 rdf:type owl:NamedIndividual ,
                       ns1:Eventually ;
              ns1:hasOperand :Blood_cultures .


###  http://notation3.org/constraints.owl#CAP_4_L1_1_2
:CAP_4_L1_1_2 rdf:type owl:NamedIndividual ,
                       ns1:Until ;
              ns1:hasLeftOperand :CAP_4_L1_1_2_1 ;
              ns1:hasRightOperand :Blood_cultures .


###  http://notation3.org/constraints.owl#CAP_4_L1_1_2_1
:CAP_4_L1_1_2_1 rdf:type owl:NamedIndividual ,
                         ns1:Negation ;
                ns1:hasOperand :Give_antibiotics .


###  http://notation3.org/constraints.owl#CAP_6
:CAP_6 rdf:type owl:NamedIndividual ,
                :PrioritizedConditional ;
       :hasCondition :Sepsis_onset ;
       :hasConditionMarker :Mark:_sepsis_onset ;
       :hasConditionalTask :Give_antibiotics ;
       :hasDecisionTask :Check_for_sepsis_onset ;
       :hasLtlFormula :CAP_6_L1 ,
                      :CAP_6_L2 ;
       rdfs:label "cap6" .


###  http://notation3.org/constraints.owl#CAP_6_L1
:CAP_6_L1 rdf:type owl:NamedIndividual ,
                   ns1:Globally ;
          ns1:hasOperand :CAP_6_L1_1 .


###  http://notation3.org/constraints.owl#CAP_6_L1_1
:CAP_6_L1_1 rdf:type owl:NamedIndividual ,
                     ns1:Implies ;
            ns1:hasLeftOperand :Mark:_sepsis_onset ;
            ns1:hasRightOperand :CAP_6_L1_1_2 .


###  http://notation3.org/constraints.owl#CAP_6_L1_1_2
:CAP_6_L1_1_2 rdf:type owl:NamedIndividual ,
                       ns1:Next ;
              ns1:hasOperand :Give_antibiotics .


###  http://notation3.org/constraints.owl#CAP_6_L2
:CAP_6_L2 rdf:type owl:NamedIndividual ,
                   ns1:Globally ;
          ns1:hasOperand :CAP_6_L2_1 .


###  http://notation3.org/constraints.owl#CAP_6_L2_1
:CAP_6_L2_1 rdf:type owl:NamedIndividual ,
                     ns1:Implies ;
            ns1:hasLeftOperand :CAP_6_L2_1_1 ;
            ns1:hasRightOperand :Check_for_sepsis_onset .


###  http://notation3.org/constraints.owl#CAP_6_L2_1_1
:CAP_6_L2_1_1 rdf:type owl:NamedIndividual ,
                       ns1:Next ;
              ns1:hasOperand :Mark:_sepsis_onset .


###  http://notation3.org/constraints.owl#CBC
:CBC rdf:type owl:NamedIndividual ,
              :Task ;
     rdfs:label "CBC" .


###  http://notation3.org/constraints.owl#COPD
:COPD rdf:type owl:NamedIndividual ,
               :ProcessModel ;
      :hasConstraint :COPD_1 ,
                     :COPD_2 ,
                     :COPD_3 ,
                     :COPD_4 ,
                     :COPD_5 ,
                     :copd_p1 ,
                     :copd_p2 ;
      rdfs:label "COPD" .


###  http://notation3.org/constraints.owl#COPD_1
:COPD_1 rdf:type owl:NamedIndividual ,
                 :DecisionalDependency ;
        :hasDecisionTask :Perform_physical_examination ;
        :hasDependentTask :Trial_immediate_resuscitation ;
        :hasLtlFormula :COPD_1_L1 ;
        :isDecisionOptional "false"^^xsd:boolean ;
        :isDependentOptional "true"^^xsd:boolean ;
        rdfs:label "copd1" .


###  http://notation3.org/constraints.owl#COPD_1_L1
:COPD_1_L1 rdf:type owl:NamedIndividual ,
                    ns1:Until ;
           ns1:hasLeftOperand :COPD_1_L1_1 ;
           ns1:hasRightOperand :Perform_physical_examination .


###  http://notation3.org/constraints.owl#COPD_1_L1_1
:COPD_1_L1_1 rdf:type owl:NamedIndividual ,
                      ns1:Negation ;
             ns1:hasOperand :Trial_immediate_resuscitation .


###  http://notation3.org/constraints.owl#COPD_2
:COPD_2 rdf:type owl:NamedIndividual ,
                 :EntryPoint ;
        :hasLtlFormula :COPD_2_L1 ;
        :hasTask :Perform_physical_examination ;
        rdfs:label "copd2" .


###  http://notation3.org/constraints.owl#COPD_2_L1
:COPD_2_L1 rdf:type owl:NamedIndividual ,
                    ns1:Next ;
           ns1:hasOperand :Perform_physical_examination .


###  http://notation3.org/constraints.owl#COPD_3
:COPD_3 rdf:type owl:NamedIndividual ,
                 :PrioritizedConditional ;
        :hasCondition :Resuscitation_need ;
        :hasConditionMarker :Mark:_resuscitation_need ;
        :hasConditionalTask :Trial_immediate_resuscitation ;
        :hasDecisionTask :Perform_physical_examination ;
        :hasLtlFormula :COPD_3_L1 ,
                       :COPD_3_L2 ;
        rdfs:label "copd3" .


###  http://notation3.org/constraints.owl#COPD_3_L1
:COPD_3_L1 rdf:type owl:NamedIndividual ,
                    ns1:Globally ;
           ns1:hasOperand :COPD_3_L1_1 .


###  http://notation3.org/constraints.owl#COPD_3_L1_1
:COPD_3_L1_1 rdf:type owl:NamedIndividual ,
                      ns1:Implies ;
             ns1:hasLeftOperand :Mark:_resuscitation_need ;
             ns1:hasRightOperand :COPD_3_L1_1_2 .


###  http://notation3.org/constraints.owl#COPD_3_L1_1_2
:COPD_3_L1_1_2 rdf:type owl:NamedIndividual ,
                        ns1:Next ;
               ns1:hasOperand :Trial_immediate_resuscitation .


###  http://notation3.org/constraints.owl#COPD_3_L2
:COPD_3_L2 rdf:type owl:NamedIndividual ,
                    ns1:Globally ;
           ns1:hasOperand :COPD_3_L2_1 .


###  http://notation3.org/constraints.owl#COPD_3_L2_1
:COPD_3_L2_1 rdf:type owl:NamedIndividual ,
                      ns1:Implies ;
             ns1:hasLeftOperand :COPD_3_L2_1_1 ;
             ns1:hasRightOperand :Perform_physical_examination .


###  http://notation3.org/constraints.owl#COPD_3_L2_1_1
:COPD_3_L2_1_1 rdf:type owl:NamedIndividual ,
                        ns1:Next ;
               ns1:hasOperand :Mark:_resuscitation_need .


###  http://notation3.org/constraints.owl#COPD_4
:COPD_4 rdf:type owl:NamedIndividual ,
                 :DecisionalDependency ;
        :hasDecisionTask :Perform_physical_examination ;
        :hasDependentTask :Conduct_baseline_blood_work ;
        :hasLtlFormula :COPD_4_L1 ;
        :isDecisionOptional "false"^^xsd:boolean ;
        :isDependentOptional "false"^^xsd:boolean ;
        rdfs:label "copd4" .


###  http://notation3.org/constraints.owl#COPD_4_L1
:COPD_4_L1 rdf:type owl:NamedIndividual ,
                    ns1:Until ;
