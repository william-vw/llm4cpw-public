      <transition id="Activity_1xq5evs">
        <name>
          <text>Repeat blood glucose measurement</text>
        </name>
      </transition>
      <transition id="Activity_1ikqh4n">
        <name>
          <text>Referral to an outpatient clinic with stroke-prevention services for comprehensive evaluation and management within 1 month of symptom onset</text>
        </name>
      </transition>
      <transition id="sfl_Flow_0m7we44">
        <name>
          <text>sfl_Flow_0m7we44</text>
        </name>
        <toolspecific tool="ProM" version="6.4" activity="$invisible$" localNodeID="6023c5cb-a8c6-43f3-b00b-d3fc85459087"/>
      </transition>
      <transition id="08d58755-e8f2-4b76-8e95-6096794feb2c">
        <name>
          <text>08d58755-e8f2-4b76-8e95-6096794feb2c</text>
        </name>
        <toolspecific tool="ProM" version="6.4" activity="$invisible$" localNodeID="21a60b70-8027-435d-a5c7-6e9018ded3d9"/>
      </transition>
      <transition id="sfl_Flow_1wc1wjf">
        <name>
          <text>sfl_Flow_1wc1wjf</text>
        </name>
        <toolspecific tool="ProM" version="6.4" activity="$invisible$" localNodeID="a3ef9507-f9dc-4a22-9aad-6448b032bc88"/>
      </transition>
      <transition id="Activity_11p6hi8">
        <name>
          <text>investigate potential infection</text>
        </name>
      </transition>
      <transition id="Activity_18mn4vn">
        <name>
          <text>Evaluate in the ED to be considered for admission to hospital</text>
        </name>
      </transition>
      <transition id="Gateway_0w634w0">
        <name>
          <text>Gateway_0w634w0</text>
        </name>
        <toolspecific tool="ProM" version="6.4" activity="$invisible$" localNodeID="c4e4b8a8-194f-403e-b08b-a1fc4682604a"/>
      </transition>
      <transition id="sfl_Flow_0c6wtqq">
        <name>
          <text>sfl_Flow_0c6wtqq</text>
        </name>
        <toolspecific tool="ProM" version="6.4" activity="$invisible$" localNodeID="84b7bbb4-d28a-40e7-a0c6-bfa26b055545"/>
      </transition>
      <transition id="Activity_06e0hxs">
        <name>
          <text>Perform glucose measurement</text>
        </name>
      </transition>
      <transition id="sfl_Flow_0j8qnot">
        <name>
          <text>sfl_Flow_0j8qnot</text>
        </name>
        <toolspecific tool="ProM" version="6.4" activity="$invisible$" localNodeID="cec24c26-f0f9-4dc2-9d5c-5f926446006a"/>
      </transition>
      <transition id="sfl_Flow_1mmx492">
        <name>
          <text>sfl_Flow_1mmx492</text>
        </name>
        <toolspecific tool="ProM" version="6.4" activity="$invisible$" localNodeID="cd2828a8-cf30-4c03-b103-439427133d56"/>
      </transition>
      <transition id="Activity_16mzwfk">
        <name>
          <text>Rectal or gastric ASA should be offered</text>
        </name>
      </transition>
      <transition id="Activity_1ghc4an">
        <name>
          <text>initiate antipyretic and antimicrobial therapy</text>
        </name>
      </transition>
      <transition id="Activity_0nwugoj">
        <name>
          <text>Aspirin (ASA) 160 mg as a loading dose, then a daily dose of 81–325 mg (usually 81 mg for maintenance)</text>
        </name>
      </transition>
      <transition id="Activity_0d6z69u">
        <name>
          <text>Brain CT scan</text>
        </name>
      </transition>
      <transition id="21c01d7a-bb0e-44ad-aaa4-418794ab9837">
        <name>
          <text>21c01d7a-bb0e-44ad-aaa4-418794ab9837</text>
        </name>
        <toolspecific tool="ProM" version="6.4" activity="$invisible$" localNodeID="860c7502-b1ae-4332-af11-61ff3417c9c9"/>
      </transition>
      <transition id="Gateway_1sf04z5">
        <name>
          <text>Gateway_1sf04z5</text>
        </name>
        <toolspecific tool="ProM" version="6.4" activity="$invisible$" localNodeID="8a5c43cf-2f39-4419-851d-daa7097e0e71"/>
      </transition>
      <transition id="sfl_Flow_1o55o8y">
        <name>
          <text>sfl_Flow_1o55o8y</text>
        </name>
        <toolspecific tool="ProM" version="6.4" activity="$invisible$" localNodeID="99d27083-08e6-4e3f-ad7b-6cf951bf90db"/>
      </transition>
      <transition id="Activity_0j4n94s">
        <name>
          <text>patient should be referred to an outpatient clinic with stroke-prevention services</text>
        </name>
      </transition>
      <transition id="Activity_0dwd38r">
        <name>
          <text>initiate temperature-reducing measures</text>
        </name>
      </transition>
      <transition id="sfl_Flow_1gc9326">
        <name>
          <text>sfl_Flow_1gc9326</text>
        </name>
        <toolspecific tool="ProM" version="6.4" activity="$invisible$" localNodeID="cf7728fe-801d-47c3-b25a-92be03fda759"/>
      </transition>
      <transition id="Activity_0wkp3es">
        <name>
          <text>Correct hypoglycemia immediately</text>
        </name>
      </transition>
      <transition id="Activity_1n92f33">
        <name>
          <text>Extended-release Dipyridamole + Aspirin (Aggrenox) 200 mg Dipyridamole + 25 mg Aspirin twice daily (initial dose includes ASA 160 mg)</text>
        </name>
      </transition>
      <transition id="sfl_Flow_1ror77w">
        <name>
          <text>sfl_Flow_1ror77w</text>
        </name>
        <toolspecific tool="ProM" version="6.4" activity="$invisible$" localNodeID="e07b5f77-cdd8-4984-a8cc-314a977240ba"/>
      </transition>
      <transition id="Gateway_0urjjn3">
        <name>
          <text>Gateway_0urjjn3</text>
        </name>
        <toolspecific tool="ProM" version="6.4" activity="$invisible$" localNodeID="0a9990c9-3def-4b9e-bb73-78c688d9503f"/>
      </transition>
      <transition id="sfl_Flow_155nghu">
        <name>
          <text>sfl_Flow_155nghu</text>
        </name>
        <toolspecific tool="ProM" version="6.4" activity="$invisible$" localNodeID="0f5630e0-0679-4dd8-8510-fa9fd0c05084"/>
      </transition>
      <transition id="Activity_19ytogb">
        <name>
          <text>Clopidogrel 300 mg as a loading dose, followed by 75 mg daily.</text>
        </name>
      </transition>
      <transition id="Activity_0gh1m4z">
        <name>
          <text>Immediate care should be provided at a specialized TIA/minor stroke clinic</text>
        </name>
      </transition>
      <transition id="sfl_Flow_0plv15t">
        <name>
          <text>sfl_Flow_0plv15t</text>
        </name>
        <toolspecific tool="ProM" version="6.4" activity="$invisible$" localNodeID="3e54b740-56e1-49e9-a5a4-42435a8e6844"/>
      </transition>
      <transition id="Activity_1sg5ww2">
        <name>
          <text>Other stroke-prevention treatments tailored to each patient</text>
        </name>
      </transition>
      <transition id="Activity_19y0anb">
        <name>
          <text>Give patients appropriate cross-continuum secondary prevention assessments and therapies</text>
        </name>
      </transition>
      <transition id="sfl_Flow_1v3u74v">
        <name>
          <text>sfl_Flow_1v3u74v</text>
        </name>
        <toolspecific tool="ProM" version="6.4" activity="$invisible$" localNodeID="7837cc2b-e3bd-4101-93e6-491e6b42349c"/>
      </transition>
      <transition id="Gateway_13hgxyn">
        <name>
          <text>Gateway_13hgxyn</text>
        </name>
        <toolspecific tool="ProM" version="6.4" activity="$invisible$" localNodeID="4340f879-1126-4459-8ce5-54c1df6d175a"/>
      </transition>
      <transition id="sfl_Flow_0br2iz8">
        <name>
          <text>sfl_Flow_0br2iz8</text>
        </name>
        <toolspecific tool="ProM" version="6.4" activity="$invisible$" localNodeID="ad1d95a4-b152-41b3-97d0-0877440098e3"/>
      </transition>
      <transition id="Activity_11aod7z">
        <name>
          <text>Evaluate temperature as part of routine vital signs every 4 hours for first 48 hours</text>
        </name>
      </transition>
      <transition id="Activity_1c6s5um">
        <name>
          <text>Consider inpatient evaluation and management for stroke prevention</text>
        </name>
      </transition>
      <transition id="Gateway_1n80g9l">
        <name>
          <text>Gateway_1n80g9l</text>
        </name>
        <toolspecific tool="ProM" version="6.4" activity="$invisible$" localNodeID="97df0e70-28f8-49a0-893d-84eed957ed7d"/>
      </transition>
      <transition id="Activity_1j89x2a">
        <name>
          <text>evaluation should occur at an appropriately resourced ED</text>
        </name>
      </transition>
      <transition id="Activity_0ak6axd">
        <name>
          <text>patient should be referred for evaluation at a specialized TIA/minor stroke clinic</text>
        </name>
      </transition>
