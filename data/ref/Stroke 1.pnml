      <transition id="Activity_0u7hhi5">
        <name>
          <text>Vascular imaging of the brain and neck arteries ASAP</text>
        </name>
      </transition>
      <transition id="Activity_0dzemrn">
        <name>
          <text>Immediate brain imaging (CT or MRI)</text>
        </name>
      </transition>
      <transition id="sfl_Flow_0xqsrvx">
        <name>
          <text>sfl_Flow_0xqsrvx</text>
        </name>
        <toolspecific tool="ProM" version="6.4" activity="$invisible$" localNodeID="deae9b7a-4be9-4a6e-86ae-b0687e47eee7"/>
      </transition>
      <transition id="sfl_Flow_0f5wl7w">
        <name>
          <text>sfl_Flow_0f5wl7w</text>
        </name>
        <toolspecific tool="ProM" version="6.4" activity="$invisible$" localNodeID="18d13b9e-c9c0-41ff-9339-9c3ea6ed27d2"/>
      </transition>
      <transition id="Activity_053zfzn">
        <name>
          <text>Screen swallowing ability as part of initial assessment and before initiating oral medication, fluid, or food.</text>
        </name>
      </transition>
      <transition id="Activity_007vkr3">
        <name>
          <text>Monitor patient closely</text>
        </name>
      </transition>
      <transition id="Activity_0ym16x5">
        <name>
          <text>Screen swallowing ability  when clinically appropriate</text>
        </name>
      </transition>
      <transition id="sfl_Flow_038n0mj">
        <name>
          <text>sfl_Flow_038n0mj</text>
        </name>
        <toolspecific tool="ProM" version="6.4" activity="$invisible$" localNodeID="8a71f1a7-d947-4860-9b5d-b7b32a54da72"/>
      </transition>
      <transition id="Activity_12vz3t2">
        <name>
          <text>Immediate vascular imaging of the neck arteries (carotid ultrasound, CTA, or MRA)</text>
        </name>
      </transition>
      <transition id="Activity_0a3vwyo">
        <name>
          <text>Use a standard triage tool to determine the appropriate location for the care of the patient</text>
        </name>
      </transition>
      <transition id="sfl_Flow_1dxge81">
        <name>
          <text>sfl_Flow_1dxge81</text>
        </name>
        <toolspecific tool="ProM" version="6.4" activity="$invisible$" localNodeID="7a5ad055-3e1e-457c-bb50-f443380db887"/>
      </transition>
      <transition id="Activity_0wnu6ye">
        <name>
          <text>Rapid initial evaluation for airway, breathing, and circulation</text>
        </name>
      </transition>
      <transition id="1c933131-872f-4400-822a-822a8d249902">
        <name>
          <text>1c933131-872f-4400-822a-822a8d249902</text>
        </name>
        <toolspecific tool="ProM" version="6.4" activity="$invisible$" localNodeID="38e38c1d-1ee4-46cf-b80c-da9c73dfa3f4"/>
      </transition>
      <transition id="Activity_11dsn6a">
        <name>
          <text>Full clinical assessment of the patient's swallowing ability by a speech-language pathologist or appropriately trained specialist to advise on swallowing ability and the required consistency of diet and fluids</text>
        </name>
      </transition>
      <transition id="Activity_1azyuxe">
        <name>
          <text>Immediate interpretation of brain imaging by healthcare provider with expertise in reading CT and/or MRI</text>
        </name>
      </transition>
      <transition id="Activity_07pokxo">
        <name>
          <text>Give patients appropriate cross-continuum secondary prevention assessments and therapies</text>
        </name>
      </transition>
      <transition id="sfl_Flow_0ywv0ls">
        <name>
          <text>sfl_Flow_0ywv0ls</text>
        </name>
        <toolspecific tool="ProM" version="6.4" activity="$invisible$" localNodeID="10b88bae-29d7-4df8-aa88-690a5eb9c2d1"/>
      </transition>
      <transition id="Activity_127htfi">
        <name>
          <text>Make patient NPO (nothing by mouth) initially</text>
        </name>
      </transition>
      <transition id="Activity_0r50tea">
        <name>
          <text>Neurological examination to determine focal neurological deficits and assess stroke severity on a standardized stroke scale (NIHSS or CNS for stroke)</text>
        </name>
      </transition>
      <transition id="sfl_Flow_17aa8gh">
        <name>
          <text>sfl_Flow_17aa8gh</text>
        </name>
        <toolspecific tool="ProM" version="6.4" activity="$invisible$" localNodeID="45193413-3712-4c06-b5d7-74370e7124e7"/>
      </transition>
      <transition id="Activity_1jeqqs5">
        <name>
          <text>Troponin test</text>
        </name>
      </transition>
      <transition id="Activity_1djtw72">
        <name>
          <text>Thrombolysis assessment</text>
        </name>
      </transition>
      <transition id="Activity_1l1hudq">
        <name>
          <text>Chest x-ray</text>
        </name>
      </transition>
      <transition id="Activity_1nzxm10">
        <name>
          <text>Blood work: CBC, electrolytes, creatinine, glucose, INR, partial thromboplastin time</text>
        </name>
      </transition>
      <transition id="Activity_18d9arj">
        <name>
          <text>ECG to detect atrial fibrillation and other acute arrhythmias</text>
        </name>
      </transition>
