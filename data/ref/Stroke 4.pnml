      <transition id="Activity_1fta8jt">
        <name>
          <text>Rapid brain imaging (non-contrast CT or MRI) and CTA (Door to CT/CTA should be less than 25 minutes)</text>
        </name>
      </transition>
      <transition id="Activity_15wsf9a">
        <name>
          <text>Evaluate patients for endovascular therapy</text>
        </name>
      </transition>
      <transition id="Activity_0wnu6ye">
        <name>
          <text>Rapid initial evaluation for airway, breathing, and circulation</text>
        </name>
      </transition>
      <transition id="Gateway_0zp83y2">
        <name>
          <text>Gateway_0zp83y2</text>
        </name>
        <toolspecific tool="ProM" version="6.4" activity="$invisible$" localNodeID="40601b65-6dd6-4b9d-9499-f83aa1bcc934"/>
      </transition>
      <transition id="sfl_Flow_1jvye5a">
        <name>
          <text>sfl_Flow_1jvye5a</text>
        </name>
        <toolspecific tool="ProM" version="6.4" activity="$invisible$" localNodeID="0a017d61-0ed3-48f8-99ba-0a92cb30d3ec"/>
      </transition>
      <transition id="Activity_0g46ts0">
        <name>
          <text>Patient should be evaluatedimmediately by physicians with expertise in stroke management</text>
        </name>
      </transition>
      <transition id="sfl_Flow_174pbej">
        <name>
          <text>sfl_Flow_174pbej</text>
        </name>
        <toolspecific tool="ProM" version="6.4" activity="$invisible$" localNodeID="79a7c6aa-8852-4a0c-acab-cfa5c57a92e3"/>
      </transition>
      <transition id="sfl_Flow_1tvufxc">
        <name>
          <text>sfl_Flow_1tvufxc</text>
        </name>
        <toolspecific tool="ProM" version="6.4" activity="$invisible$" localNodeID="e32d093c-c6ec-4da5-9f42-483c1842975f"/>
      </transition>
      <transition id="Activity_1cm9g6a">
        <name>
          <text>Advanced CT and multiphase CTA or Perfusion CT</text>
        </name>
      </transition>
      <transition id="sfl_Flow_1fncmd8">
        <name>
          <text>sfl_Flow_1fncmd8</text>
        </name>
        <toolspecific tool="ProM" version="6.4" activity="$invisible$" localNodeID="6a11cd10-3f23-40fc-bf5d-d6a642124e24"/>
      </transition>
      <transition id="sfl_Flow_19glxch">
        <name>
          <text>sfl_Flow_19glxch</text>
        </name>
        <toolspecific tool="ProM" version="6.4" activity="$invisible$" localNodeID="e66bb607-dd19-4662-9108-335b0a5ca3cd"/>
      </transition>
      <transition id="Activity_1l1hudq">
        <name>
          <text>Chest x-ray</text>
        </name>
      </transition>
      <transition id="sfl_Flow_18aoc4d">
        <name>
          <text>sfl_Flow_18aoc4d</text>
        </name>
        <toolspecific tool="ProM" version="6.4" activity="$invisible$" localNodeID="fe15015b-7051-4b5d-8fc8-e72b4615823e"/>
      </transition>
      <transition id="sfl_Flow_10n332a">
        <name>
          <text>sfl_Flow_10n332a</text>
        </name>
        <toolspecific tool="ProM" version="6.4" activity="$invisible$" localNodeID="9d6bef7c-f0a9-4dad-bd42-c6242ce0704f"/>
      </transition>
      <transition id="Activity_1mrrfmh">
        <name>
          <text>Thrombolysis assessment</text>
        </name>
      </transition>
      <transition id="Activity_12zuvbf">
        <name>
          <text>Screen swallowing ability as part of initial assessment and before initiating oral medication, fluid, or food.</text>
        </name>
      </transition>
      <transition id="Activity_11dsn6a">
        <name>
          <text>Full clinical assessment of the patient's swallowing ability by a speech-language pathologist or appropriately trained specialist who would advise on swallowing ability and the required consistency of diet and fluids</text>
        </name>
      </transition>
      <transition id="sfl_Flow_1ch5aes">
        <name>
          <text>sfl_Flow_1ch5aes</text>
        </name>
        <toolspecific tool="ProM" version="6.4" activity="$invisible$" localNodeID="d3823bd8-acd5-45d5-b016-d3a8b1960726"/>
      </transition>
      <transition id="Activity_127htfi">
        <name>
          <text>Make patient NPO (nothing by mouth) initially</text>
        </name>
      </transition>
      <transition id="9171085b-1337-4b1c-8a6c-8652c2c105c6">
        <name>
          <text>9171085b-1337-4b1c-8a6c-8652c2c105c6</text>
        </name>
        <toolspecific tool="ProM" version="6.4" activity="$invisible$" localNodeID="cdf0f511-8215-41b2-bcb3-70ff04c7e0fa"/>
      </transition>
      <transition id="Activity_1a982nj">
        <name>
          <text>Treat patient as a medical emergency. ICH should be promptly recognized</text>
        </name>
      </transition>
      <transition id="Activity_007vkr3">
        <name>
          <text>Monitor patient closely</text>
        </name>
      </transition>
      <transition id="Activity_0c4g6x0">
        <name>
          <text>Perform troponin test</text>
        </name>
      </transition>
      <transition id="Activity_02bkzjo">
        <name>
          <text>Evaluation should include questionsabout anticoagulant therapy, measurement of platelet count, PTT, and INR</text>
        </name>
      </transition>
      <transition id="sfl_Flow_1xhj9y7">
        <name>
          <text>sfl_Flow_1xhj9y7</text>
        </name>
        <toolspecific tool="ProM" version="6.4" activity="$invisible$" localNodeID="27de99b4-80e3-4198-9775-23bec6a3e89d"/>
      </transition>
      <transition id="Activity_07pokxo">
        <name>
          <text>Give patients appropriate cross-continuum secondary prevention assessments and therapies</text>
        </name>
      </transition>
      <transition id="Activity_0r50tea">
        <name>
          <text>Neurological examination to determine focal neurological deficits and assess stroke severity on a standardized stroke scale (NIHSS or CNS for stroke)</text>
        </name>
      </transition>
      <transition id="Activity_1nzxm10">
        <name>
          <text>Blood work: CBC, electrolytes, creatinine, glucose, INR, partial thromboplastin time</text>
        </name>
      </transition>
      <transition id="Activity_1g4wqtb">
        <name>
          <text>Screen swallowing ability when clinically appropriate</text>
        </name>
      </transition>
      <transition id="Activity_055s44x">
        <name>
          <text>CTA or MRA ASAP</text>
        </name>
      </transition>
      <transition id="sfl_Flow_1sfwyh4">
        <name>
          <text>sfl_Flow_1sfwyh4</text>
        </name>
        <toolspecific tool="ProM" version="6.4" activity="$invisible$" localNodeID="73de1708-3785-4123-bdc7-0faf85209637"/>
      </transition>
      <transition id="efdc3d89-4650-4e54-bb8b-8ef5f3130856">
        <name>
          <text>efdc3d89-4650-4e54-bb8b-8ef5f3130856</text>
        </name>
        <toolspecific tool="ProM" version="6.4" activity="$invisible$" localNodeID="8b9df8dd-0e9a-47c3-92e3-6ab535258419"/>
      </transition>
      <transition id="Activity_18d9arj">
        <name>
          <text>ECG to detect atrial fibrillation and other acute arrhythmias</text>
        </name>
      </transition>
      <transition id="cf249fbd-7b9b-4b07-9fbc-dadee0e0aaca">
        <name>
          <text>cf249fbd-7b9b-4b07-9fbc-dadee0e0aaca</text>
        </name>
        <toolspecific tool="ProM" version="6.4" activity="$invisible$" localNodeID="c9e125a2-3cfc-4d80-9442-b8e9157f1410"/>
      </transition>
      <transition id="sfl_Flow_0lnelcs">
        <name>
          <text>sfl_Flow_0lnelcs</text>
        </name>
        <toolspecific tool="ProM" version="6.4" activity="$invisible$" localNodeID="ee2008a6-cace-4698-ab07-5c494943b7b5"/>
      </transition>
      <transition id="Activity_0u7hhi5">
        <name>
          <text>Vascular imaging of the brain and neck arteries ASAP</text>
        </name>
      </transition>
      <transition id="Activity_0q4fstn">
        <name>
          <text>Immediate expert healthcare provider interpretation of the brain imaging</text>
        </name>
      </transition>
