node [shape="box"];
	nActivity_1yl1883[label="Admit the patient to a specialized, geographicallydefined hospital unit dedicated to the management of stroke patients with the following requirements:1- The core stroke unit team should consist of health care professionals with stroke expertise in medicine, nursing, occupational therapy, physiotherapy, speech-language pathology, social work, and clinical nutrition (a dietitian).2- To have the necessary stroke expertise, the health care professionals on the core stroke unit team should be individuals who spend the vast majority of their time treating stroke patients and regularly complete education about stroke care.3- Patients should have access to a specialized interprofessional team 7 days a week" width=".3" fillcolor="#9ACD32" height=".3"];
	nGateway_11t13oc[label="Gateway_11t13oc" width=".3" height=".3"];
	nActivity_0rfbuau[label="Use standardized, valid assessment tools to evaluate patients’ stroke-related impairments and functional status" width=".3" height=".3"];
	nsfl_Flow_0v1q7l6[label="sfl_Flow_0v1q7l6" width=".3" height=".3"];
	nActivity_0xmrwmu[label="Encourage early mobilization and adequate hydration for all acute stroke patients to help prevent venous thromboembolism" width=".3" height=".3"];
	nActivity_06pegrd[label="Assess nutrition and hydration status of stroke patients within the first 48 hours of admission using a valid screening tool" width=".3" height=".3"];
	nActivity_1affqt1[label="Assess patient for risk of developing venous thromboembolism" width=".3" height=".3"];
	nActivity_1a4xmof[label="Give patient a referral to a dietitian within 7 days of admission for recommendations and consideration of enteral nutrition support if nutritional and fluid requirements cannot be met" width=".3" height=".3"];
	nActivity_0s2vtav[label="Patient should be mobilized" width=".3" height=".3"];
	nActivity_0twgmyz[label="Physiotherapy, speech-language pathology, and occupational therapy team members should assess stroke patients within 48 hours of admission to hospital and formulate a management plan" width=".3" height=".3"];
	nActivity_0r95hhl[label="Mobilize patient" width=".3" height=".3"];
